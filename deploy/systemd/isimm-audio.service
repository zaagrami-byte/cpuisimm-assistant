# Pi : sudo cp deploy/systemd/isimm-audio.service /etc/systemd/system/
[Unit]
Description=ISIMM robot audio client (micro/haut-parleur <-> PC)
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=isimmassistant
SupplementaryGroups=audio
WorkingDirectory=/home/isimmassistant/isimm
EnvironmentFile=/etc/isimm/audio.env
ExecStart=/usr/bin/python3 -m robot_audio
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
