# ISIMM ROBOT - règles udev
# Arduino Uno officiel : identifié par VID:PID (2341:0043)
# ESP32 et RPLIDAR : deux CP2102 identiques -> identifiés par le PORT USB PHYSIQUE.
# Ne pas permuter les câbles. Accès via le groupe dialout (pas de 0666).
# ID_MM_DEVICE_IGNORE : empêche ModemManager de saisir les ports.

SUBSYSTEM=="tty", KERNEL=="ttyACM*", ATTRS{idVendor}=="2341", ATTRS{idProduct}=="0043", SYMLINK+="isimm_arduino", GROUP="dialout", MODE="0660", ENV{ID_MM_DEVICE_IGNORE}="1"

# ESP32 - CP2102 sur port USB physique 1-1.2
SUBSYSTEM=="tty", KERNEL=="ttyUSB*", ENV{ID_PATH}=="platform-fd500000.pcie-pci-0000:01:00.0-usb-0:1.2:1.0", SYMLINK+="isimm_esp32", GROUP="dialout", MODE="0660", ENV{ID_MM_DEVICE_IGNORE}="1"

# RPLIDAR - CP2102 sur port USB physique 1-1.3
SUBSYSTEM=="tty", KERNEL=="ttyUSB*", ENV{ID_PATH}=="platform-fd500000.pcie-pci-0000:01:00.0-usb-0:1.3:1.0", SYMLINK+="isimm_rplidar", GROUP="dialout", MODE="0660", ENV{ID_MM_DEVICE_IGNORE}="1"
