# ISIMM ROBOT - règles udev
# Identification par port USB physique pour les deux CP2102 identiques.

# Arduino Uno officiel - 2341:0043
SUBSYSTEM=="tty", ATTRS{idVendor}=="2341", ATTRS{idProduct}=="0043", SYMLINK+="isimm_arduino", MODE="0666"

# ESP32 - CP2102 sur port USB physique 1-1.2
SUBSYSTEM=="tty", ENV{ID_PATH}=="platform-fd500000.pcie-pci-0000:01:00.0-usb-0:1.2:1.0", SYMLINK+="isimm_esp32", MODE="0666"

# RPLIDAR - CP2102 sur port USB physique 1-1.3
SUBSYSTEM=="tty", ENV{ID_PATH}=="platform-fd500000.pcie-pci-0000:01:00.0-usb-0:1.3:1.0", SYMLINK+="isimm_rplidar", MODE="0666"
