# === Copier en ai/.env (jamais commité) ===
# Sécurité : true = navigate_to ne déplace PAS le robot (simulation).
AI_DRY_RUN=true

# --- Réseau (config centrale) ---
PC_IP=192.168.1.20
ROBOT_IP=192.168.1.30
ROBOT_HOST=robotcpu-pi
AUDIO_HOST=0.0.0.0
AUDIO_PORT=5005

# --- ROS 2 (identique sur le Pi) ---
ROS_DOMAIN_ID=0

# --- IA ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
WHISPER_MODEL=small
PIPER_MODEL=models/fr_FR-siwis-medium.onnx
LANGUAGE=fr
